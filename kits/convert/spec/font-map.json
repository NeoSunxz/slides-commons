{
  "note": "Maps fonts commonly found in PPTX files (and on screenshots) to open fonts that Google Fonts serves. `use` is the family to put in the template; `google` is the family spec for the fonts.googleapis.com css2 URL; `embed` is true when tools/embed-cjk.mjs / the kit's fonts/ table can embed it (CJK families only).",
  "fonts": [
    { "match": ["Microsoft YaHei", "微软雅黑", "Microsoft YaHei UI", "MicrosoftYaHei"], "category": "cjk-sans", "use": "Noto Sans SC", "google": "Noto+Sans+SC:wght@400;500;700", "embed": true, "note": "closest open match; pair with Inter or Arimo for the Latin part" },
    { "match": ["PingFang SC", "苹方", "PingFang TC", "PingFang HK", "Hiragino Sans GB", "冬青黑体简体中文", "STHeiti", "华文细黑", "Heiti SC", "黑体-简", "Heiti TC"], "category": "cjk-sans", "use": "Noto Sans SC", "google": "Noto+Sans+SC:wght@400;500;700", "embed": true, "note": "same neutral modern sans feel" },
    { "match": ["SimHei", "黑体"], "category": "cjk-sans", "use": "Noto Sans SC", "google": "Noto+Sans+SC:wght@700", "embed": true, "note": "SimHei is a single heavy weight: use 700 for it" },
    { "match": ["DengXian", "等线", "DengXian Light", "等线 Light"], "category": "cjk-sans", "use": "Noto Sans SC", "google": "Noto+Sans+SC:wght@300;400;700", "embed": true, "note": "DengXian is lighter than YaHei: use 300 or 400 for body" },
    { "match": ["Source Han Sans", "Source Han Sans SC", "思源黑体", "Noto Sans CJK SC", "Noto Sans SC"], "category": "cjk-sans", "use": "Noto Sans SC", "google": "Noto+Sans+SC:wght@400;500;700", "embed": true, "note": "the same design (identical glyphs)" },
    { "match": ["SimSun", "宋体", "NSimSun", "新宋体", "STSong", "华文宋体", "Songti SC", "宋体-简", "STZhongsong", "华文中宋"], "category": "cjk-serif", "use": "Noto Serif SC", "google": "Noto+Serif+SC:wght@400;600;700", "embed": true, "note": "open serif (Song/Ming) style" },
    { "match": ["Source Han Serif", "Source Han Serif SC", "思源宋体", "Noto Serif CJK SC", "Noto Serif SC"], "category": "cjk-serif", "use": "Noto Serif SC", "google": "Noto+Serif+SC:wght@400;600;700", "embed": true, "note": "the same design (identical glyphs)" },
    { "match": ["FangSong", "仿宋", "STFangsong", "华文仿宋", "FangSong_GB2312"], "category": "cjk-serif", "use": "Noto Serif SC", "google": "Noto+Serif+SC:wght@400", "embed": true, "note": "no open Fangsong on Google Fonts; Noto Serif SC is the nearest calm serif" },
    { "match": ["KaiTi", "楷体", "STKaiti", "华文楷体", "Kaiti SC", "楷体-简", "KaiTi_GB2312"], "category": "cjk-kai", "use": "LXGW WenKai TC", "google": "LXGW+WenKai+TC:wght@400;700", "embed": true, "note": "an open Kai-style font; it is a Traditional-Chinese face, so a few glyphs show Taiwan forms and punctuation is centred. For Simplified Chinese body text prefer Noto Serif SC and keep LXGW WenKai TC for short punctuation-free headings" },
    { "match": ["HarmonyOS Sans SC", "HarmonyOS Sans", "HarmonyOS Sans SC Medium", "HarmonyOS Sans SC Light", "HarmonyOS Sans SC Bold", "HarmonyOS Sans SC Regular", "HarmonyOS Sans SC Black", "HarmonyOS Sans TC", "鸿蒙黑体"], "category": "cjk-sans", "use": "Noto Sans SC", "google": "Noto+Sans+SC:wght@400;500;700", "embed": true, "note": "Huawei's neutral geometric sans (not an open font: do not ship it); Noto Sans SC is the closest open match. Its Latin part is also geometric: pair with Inter" },
    { "match": ["Alibaba PuHuiTi", "Alibaba PuHuiTi 2.0", "Alibaba PuHuiTi 3.0", "AlibabaPuHuiTi", "阿里巴巴普惠体", "阿里巴巴普惠体 2.0", "阿里巴巴普惠体 3.0"], "category": "cjk-sans", "use": "Noto Sans SC", "google": "Noto+Sans+SC:wght@400;500;700", "embed": true, "note": "neutral sans, close to Source Han Sans; pair with Inter for the Latin part" },
    { "match": ["OPPOSans", "OPPO Sans", "OPPO Sans 4.0"], "category": "cjk-sans", "use": "Noto Sans SC", "google": "Noto+Sans+SC:wght@400;500;700", "embed": true, "note": "OPPO's rounded-geometric sans; Noto Sans SC is the nearest open face; pair with Inter" },
    { "match": ["MiSans", "MiSans VF", "MiSans Latin", "小米兰亭"], "category": "cjk-sans", "use": "Noto Sans SC", "google": "Noto+Sans+SC:wght@400;500;700", "embed": true, "note": "Xiaomi's neutral sans; use Noto Sans SC and Inter for the Latin part" },
    { "match": ["vivo Sans", "vivoSans", "vivo Sans SC"], "category": "cjk-sans", "use": "Noto Sans SC", "google": "Noto+Sans+SC:wght@400;500;700", "embed": true, "note": "vivo's neutral sans; use Noto Sans SC and Inter for the Latin part" },
    { "match": ["Smiley Sans", "SmileySans", "SmileySans-Oblique", "得意黑"], "category": "cjk-sans", "use": "Noto Sans SC", "google": "Noto+Sans+SC:wght@700", "embed": true, "note": "Smiley Sans (OFL) is a slanted display face that is not on Google Fonts, so it cannot be embedded here: use Noto Sans SC 700 and imitate the slant with font-style: italic (synthesised) on short display strings only" },
    { "match": ["FZLanTingHei", "FZLanTingHei-R-GBK", "方正兰亭黑", "方正兰亭黑_GBK", "方正兰亭黑简体", "方正兰亭细黑", "方正黑体", "FZHei-B01", "方正正黑简体", "方正粗黑宋简体", "FZCuHeiSongS-B-GB"], "category": "cjk-sans", "use": "Noto Sans SC", "google": "Noto+Sans+SC:wght@400;500;700", "embed": true, "note": "FounderType (方正) sans faces are commercial; Noto Sans SC is the open equivalent (use 700 for the heavy cuts such as 粗黑)" },
    { "match": ["FZShuSong-Z01", "方正书宋", "方正书宋简体", "方正小标宋", "方正小标宋简体", "FZXiaoBiaoSong-B05", "方正大标宋简体", "方正报宋"], "category": "cjk-serif", "use": "Noto Serif SC", "google": "Noto+Serif+SC:wght@400;600;700", "embed": true, "note": "FounderType (方正) Song faces are commercial; Noto Serif SC is the open equivalent (use 700 for 小标宋 headings)" },
    { "match": ["方正楷体", "方正楷体简体", "FZKai-Z03", "方正仿宋简体", "FZFangSong-Z02", "方正姚体", "方正舒体"], "category": "cjk-kai", "use": "Noto Serif SC", "google": "Noto+Serif+SC:wght@400", "embed": true, "note": "FounderType (方正) Kai / Fangsong faces are commercial; for a Kai feel on a short punctuation-free heading use LXGW WenKai TC, otherwise Noto Serif SC" },
    { "match": ["Source Han Sans CN", "Source Han Sans SC VF", "思源黑体 CN", "思源黑体 Normal", "思源黑体 Medium", "思源黑体 Bold", "Noto Sans CJK", "Noto Sans CJK SC Regular"], "category": "cjk-sans", "use": "Noto Sans SC", "google": "Noto+Sans+SC:wght@400;500;700", "embed": true, "note": "the same design (identical glyphs)" },
    { "match": ["Source Han Serif CN", "思源宋体 CN", "思源宋体 Heavy", "思源宋体 SemiBold", "Noto Serif CJK"], "category": "cjk-serif", "use": "Noto Serif SC", "google": "Noto+Serif+SC:wght@400;600;700", "embed": true, "note": "the same design (identical glyphs)" },
    { "match": ["Microsoft JhengHei", "微軟正黑體", "PMingLiU", "新細明體", "MingLiU"], "category": "cjk-tc", "use": "Noto Sans TC", "google": "Noto+Sans+TC:wght@400;500;700", "embed": false, "note": "Traditional Chinese; not in the kit's embed table, so it stays a Google Fonts link (works online only)" },
    { "match": ["Yu Gothic", "游ゴシック", "Meiryo", "メイリオ", "MS Gothic", "MS PGothic", "Hiragino Kaku Gothic Pro", "Hiragino Sans", "ヒラギノ角ゴ Pro"], "category": "jp-sans", "use": "Noto Sans JP", "google": "Noto+Sans+JP:wght@400;500;700", "embed": true, "note": "Japanese" },
    { "match": ["Yu Mincho", "游明朝", "MS Mincho", "MS PMincho", "Hiragino Mincho Pro"], "category": "jp-serif", "use": "Noto Serif JP", "google": "Noto+Serif+JP:wght@400;700", "embed": false, "note": "Japanese serif; not in the kit's embed table, so it stays a Google Fonts link" },
    { "match": ["Malgun Gothic", "맑은 고딕", "Apple SD Gothic Neo", "Dotum", "Gulim"], "category": "kr-sans", "use": "Noto Sans KR", "google": "Noto+Sans+KR:wght@400;500;700", "embed": false, "note": "Korean; not in the kit's embed table, so it stays a Google Fonts link" },

    { "match": ["Calibri", "Calibri Light"], "category": "sans", "use": "Carlito", "google": "Carlito:wght@400;700", "note": "metric-compatible with Calibri (same text width); there is no Light weight, use 400" },
    { "match": ["Aptos", "Aptos Display", "Aptos Narrow", "Aptos Light"], "category": "sans", "use": "Inter", "google": "Inter:wght@400;500;600;700", "note": "Office's newer default; Inter has the same neutral look" },
    { "match": ["Helvetica Now Display", "Helvetica Now", "Neue Haas Grotesk Display", "Neue Haas Grotesk", "Neue Haas Unica", "Neue Montreal", "PP Neue Montreal", "Aeonik", "General Sans", "SF Pro Display", "SF Pro", "San Francisco"], "category": "tight-display-sans", "use": "Inter Tight", "google": "Inter+Tight:wght@400;500;600;700", "embed": false, "note": "tight display neo-grotesk (headlines with negative tracking); alternatives: Inter (text sizes) or Arimo (a plainer Helvetica feel)" },
    { "match": ["Arial", "Helvetica", "Helvetica Neue", "Arial Nova", "Liberation Sans", "Nimbus Sans"], "category": "sans", "use": "Arimo", "google": "Arimo:wght@400;500;600;700", "note": "metric-compatible with Arial; for a more modern look use Inter" },
    { "match": ["Segoe UI", "Segoe UI Semibold", "Segoe UI Light", "SF Pro Text", ".SF NS", "-apple-system", "system-ui"], "category": "sans", "use": "Inter", "google": "Inter:wght@300;400;500;600;700", "note": "neutral UI sans" },
    { "match": ["Verdana", "Tahoma", "Trebuchet MS", "Lucida Sans", "Lucida Grande"], "category": "sans", "use": "Open Sans", "google": "Open+Sans:wght@400;600;700", "note": "humanist sans, wide like Verdana" },
    { "match": ["Century Gothic", "Avant Garde", "ITC Avant Garde Gothic", "Futura", "Futura PT"], "category": "geometric-sans", "use": "Jost", "google": "Jost:wght@400;500;600;700", "note": "geometric sans in the Futura family" },
    { "match": ["Avenir", "Avenir Next", "Avenir Next LT Pro", "Gill Sans", "Gill Sans MT", "Optima"], "category": "humanist-sans", "use": "Nunito Sans", "google": "Nunito+Sans:wght@400;600;700", "note": "friendly humanist sans" },
    { "match": ["Franklin Gothic", "Franklin Gothic Book", "Franklin Gothic Medium", "Libre Franklin"], "category": "sans", "use": "Libre Franklin", "google": "Libre+Franklin:wght@400;500;600;700", "note": "the Franklin Gothic revival" },
    { "match": ["Impact", "Haettenschweiler", "Anton"], "category": "display", "use": "Anton", "google": "Anton", "note": "single heavy condensed weight" },
    { "match": ["Arial Black", "Helvetica Black"], "category": "display", "use": "Archivo Black", "google": "Archivo+Black", "note": "single black weight" },
    { "match": ["Arial Narrow", "Helvetica Condensed", "Franklin Gothic Condensed"], "category": "condensed", "use": "Archivo Narrow", "google": "Archivo+Narrow:wght@400;600;700", "note": "narrow sans" },
    { "match": ["Montserrat", "Poppins", "Lato", "Open Sans", "Roboto", "Inter", "Noto Sans", "Source Sans Pro", "Source Sans 3", "Nunito", "Raleway", "Work Sans", "DM Sans", "Manrope", "Barlow", "IBM Plex Sans", "Space Grotesk", "Rubik", "Oswald", "Playfair Display", "Lora", "Merriweather", "EB Garamond", "Cormorant Garamond", "Libre Baskerville"], "category": "already-open", "use": "(same family)", "google": "", "note": "already an open Google Fonts family: use it as it is" },

    { "match": ["Times New Roman", "Times", "Liberation Serif", "Nimbus Roman"], "category": "serif", "use": "Tinos", "google": "Tinos:wght@400;700", "note": "metric-compatible with Times New Roman" },
    { "match": ["Georgia"], "category": "serif", "use": "Gelasio", "google": "Gelasio:wght@400;500;600;700", "note": "metric-compatible with Georgia" },
    { "match": ["Cambria", "Cambria Math"], "category": "serif", "use": "Caladea", "google": "Caladea:wght@400;700", "note": "metric-compatible with Cambria" },
    { "match": ["Palatino", "Palatino Linotype", "Book Antiqua", "Bookman Old Style", "Constantia"], "category": "serif", "use": "EB Garamond", "google": "EB+Garamond:wght@400;500;600;700", "note": "classic book serif; for a sturdier Palatino look use Libre Baskerville" },
    { "match": ["Garamond", "Adobe Garamond Pro", "Baskerville", "Didot", "Bodoni MT", "Bodoni"], "category": "serif", "use": "Cormorant Garamond", "google": "Cormorant+Garamond:wght@400;500;600;700", "note": "elegant high-contrast serif (Didot/Bodoni: use Bodoni Moda)" },
    { "match": ["Rockwell", "Rockwell Condensed", "Clarendon"], "category": "slab", "use": "Zilla Slab", "google": "Zilla+Slab:wght@400;500;600;700", "note": "slab serif" },
    { "match": ["Courier New", "Courier", "Liberation Mono"], "category": "mono", "use": "Cousine", "google": "Cousine:wght@400;700", "note": "metric-compatible with Courier New; for a nicer mono use JetBrains Mono" },
    { "match": ["Consolas", "Menlo", "Monaco", "SF Mono", "Lucida Console", "Andale Mono"], "category": "mono", "use": "Inconsolata", "google": "Inconsolata:wght@400;700", "note": "Consolas-like; or JetBrains Mono" },
    { "match": ["Brush Script MT", "Segoe Script", "Lucida Handwriting", "Bradley Hand", "Comic Sans MS", "Ink Free"], "category": "script", "use": "Caveat", "google": "Caveat:wght@400;700", "note": "handwriting; Comic Sans: use Comic Neue" },
    { "match": ["Wingdings", "Wingdings 2", "Wingdings 3", "Webdings", "Symbol", "Segoe UI Symbol", "Segoe UI Emoji"], "category": "symbol", "use": "(inline SVG or Unicode)", "google": "", "note": "symbol fonts have no open equivalent: redraw the icon as inline SVG or CSS" }
